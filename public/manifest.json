{
  "manifest_version": 3,
  "name": "乐仓新客户端原型",
  "description": "在乐仓系统页面中展示新客户端原型。",
  "version": "0.6.2",
  "permissions": ["tabs", "scripting", "activeTab", "storage"],
  "action": {
    "default_title": "乐仓原型",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.lecangs.com/*", "http://*.lecangs.com/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*"],
      "matches": ["https://*.lecangs.com/*", "http://*.lecangs.com/*", "http://localhost/*", "http://127.0.0.1/*"]
    }
  ]
}
